{
  "name": "shipping-risk-intel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx scripts/dev-setup.ts && next dev",
    "seed": "tsx scripts/seed.ts",
    "db:push": "drizzle-kit push --force",
    "fullflow": "tsx scripts/full-flow.ts",
    "timing": "tsx scripts/timing-check.ts",
    "build": "next build",
    "vercel-build": "drizzle-kit push --force && tsx scripts/seed.ts --if-empty && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.0",
    "geist": "^1.9.2",
    "next": "^15.4.0",
    "pg": "^8.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "dotenv": "^16.5.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.4.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "packageManager": "pnpm@9.15.9"
}
