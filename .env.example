# Postgres connection — the only env var that differs between local and Vercel.
# Local (docker compose up -d): the URL below.
# Vercel: point DATABASE_URL at the Neon connection string instead.
DATABASE_URL=postgres://shipping:shipping@localhost:5432/shipping_risk_intel

# LLM provider for document extraction. Empty/unset = the deterministic mock
# (no network, no key). A live provider activates with NO code change: set
# LLM_PROVIDER to a registered provider name and add its key env var(s) here
# or in your host's environment (see src/llm/index.ts — the registry is the
# only place that knows providers).
# LLM_PROVIDER=mock
