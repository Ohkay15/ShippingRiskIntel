# Postgres connection — the only env var that differs between local and Vercel.
# Local (docker compose up -d): the URL below.
# Vercel: the Neon integration sets DATABASE_URL for you.
DATABASE_URL=postgres://shipping:shipping@localhost:5432/shipping_risk_intel

# ---------------------------------------------------------------------------
# Integrations — every line below is optional. A connector switches on when
# its variables are set; until then the app runs on built-in sample data.
# The Integrations page (/integrations) shows what is connected and what is
# missing. Catalog: src/integrations/catalog.ts
# ---------------------------------------------------------------------------

# Public base URL used for links in outbound events (Vercel sets
# VERCEL_PROJECT_PRODUCTION_URL automatically, so this is usually unneeded).
# APP_BASE_URL=https://your-app.vercel.app

# --- AI models (document extraction + the assistant) -----------------------
# Either key activates a live model; with both, LLM_PROVIDER picks one.
# No key = deterministic mock extraction + offline assistant.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.5
# LLM_PROVIDER=anthropic   # anthropic | openai | mock

# --- Carrier safety ----------------------------------------------------------
# Free FMCSA web key: https://mobile.fmcsa.dot.gov/QCDevsite/
# FMCSA_WEB_KEY=
# Partner access required (adapter slot ready):
# HIGHWAY_API_KEY=
# HIGHWAY_API_URL=
# CARRIER_ASSURE_API_KEY=
# CARRIER_ASSURE_API_URL=

# --- Cargo insurance (partner access required; estimator used until then) ---
# LOADSURE_API_KEY=
# LOADSURE_API_URL=
# REDKIK_API_KEY=
# REDKIK_API_URL=
# BREEZE_API_KEY=
# BREEZE_API_URL=

# --- Parcel rates --------------------------------------------------------------
# EASYPOST_API_KEY=

# --- TMS / inbound loads ---------------------------------------------------------
# Shared secret for POST /api/integrations/inbound (any TMS, Zap or script).
# INBOUND_WEBHOOK_SECRET=
# Partner TMS adapters (partner access required):
# MCLEOD_API_KEY=
# MCLEOD_API_URL=
# MERCURYGATE_API_KEY=
# MERCURYGATE_API_URL=
# TURVO_API_KEY=
# REVENOVA_INSTANCE_URL=
# REVENOVA_ACCESS_TOKEN=
# ALVYS_API_KEY=

# --- CRM ------------------------------------------------------------------------
# HubSpot private-app token (scopes: crm.objects.companies.read, crm.objects.notes.write)
# HUBSPOT_ACCESS_TOKEN=

# --- Alerts -----------------------------------------------------------------------
# SLACK_WEBHOOK_URL=
# TEAMS_WEBHOOK_URL=

# --- Automation -------------------------------------------------------------------
# Signed JSON event per scored/actioned shipment (Zapier, Make, n8n…)
# OUTBOUND_WEBHOOK_URL=
# OUTBOUND_WEBHOOK_SECRET=
# Bearer key for the MCP server at /api/mcp (Claude, ChatGPT, agents)
# MCP_API_KEY=
